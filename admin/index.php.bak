  </div>

  <!-- Generate Keys -->
  <div class="glass card-hover p-6 rounded-2xl border border-white/10">
    <h2 class="text-lg font-semibold mb-3">🔑 Generate Keys</h2>
    <form method="post" action="/admin/actions.php" class="grid md:grid-cols-4 gap-3">
      <input name="credits" type="number" placeholder="Credits" class="px-4 py-2 rounded-xl bg-white/10 border border-white/20" required>
      <input name="days" type="number" placeholder="Days" class="px-4 py-2 rounded-xl bg-white/10 border border-white/20" required>
      <input name="count" type="number" value="1" placeholder="Count" class="px-4 py-2 rounded-xl bg-white/10 border border-white/20">
      <input type="hidden" name="act" value="gen_keys">
      <button class="px-4 py-2 rounded-xl bg-fuchsia-500/20 border border-fuchsia-500/40 hover:bg-fuchsia-500/30">Generate</button>
    </form>
    <?php if (!empty($_SESSION['gen_keys'])): $list=$_SESSION['gen_keys']; unset($_SESSION['gen_keys']); ?>
      <div class="mt-4 grid md:grid-cols-2 gap-2">
        <?php foreach ($list as $k): ?>
          <div class="px-3 py-2 rounded-xl bg-white/10 border border-white/20 font-mono text-xs select-all"><?= htmlspecialchars($k, ENT_QUOTES) ?></div>
        <?php endforeach; ?>
      </div>
    <?php endif; ?>
  </div>

  <!-- Users -->
  <div class="glass card-hover p-6 rounded-2xl border border-white/10 overflow-auto">
    <h2 class="text-lg font-semibold mb-3">👥 Users</h2>
    <table class="w-full text-sm border-collapse">
      <thead class="text-white/70 border-b border-white/20">
        <tr>
          <th>ID</th><th>Name</th><th>User</th><th>Credits</th><th>Checks</th><th>Lives</th><th>Premium</th><th>Role</th>
        </tr>
      </thead>
      <tbody>
      <?php foreach ($users as $r): ?>
        <tr class="border-t border-white/10 hover:bg-white/5">
          <td><?= $r['id'] ?></td>
          <td><?= htmlspecialchars(trim(($r['first_name'] ?? '').' '.($r['last_name'] ?? '')), ENT_QUOTES) ?></td>
          <td>@<?= htmlspecialchars($r['username'] ?? '—', ENT_QUOTES) ?></td>
          <td><?= $r['credits'] ?></td>
          <td><?= $r['checks_total'] ?></td>
          <td><?= $r['lives_total'] ?></td>
          <td><?= htmlspecialchars($r['premium_until'] ?? '—', ENT_QUOTES) ?></td>
          <td><?= $r['role'] ?></td>
        </tr>
      <?php endforeach; ?>
      </tbody>
    </table>
  </div>
