<main class="p-6 max-w-7xl mx-auto space-y-8">
  <?php if ($flash): ?>
    <div class="glass px-4 py-3 rounded-xl border border-white/20 text-sm"><?= htmlspecialchars($flash, ENT_QUOTES) ?></div>
  <?php endif; ?>

  <div class="grid md:grid-cols-3 gap-6">
    <div class="glass card-hover p-6 rounded-2xl border border-white/10">
      <div class="text-sm text-white/60">Total Users</div>
      <div class="text-4xl font-bold mt-2"><?= $tot_users ?></div>
    </div>
    <div class="glass card-hover p-6 rounded-2xl border border-white/10">
      <div class="text-sm text-white/60">Global Live</div>
      <div class="text-4xl font-bold mt-2"><?= $global_live ?></div>
